{
  "manifest_version": 3,
  "name": "PS5 Directo",
  "version": "1.2.1",
  "description": "Manda enlaces a PS5 Directo: al descargar un .rar/.7z/.zip/.pkg, o con clic derecho en un enlace o un texto seleccionado. Muestra el progreso de la cola.",
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "cookies",
    "contextMenus",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PS5 Directo",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}